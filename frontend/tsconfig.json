{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["@emotion/react/types/css-prop", "vite/client", "node"],
    "paths": { "@phoenix/*": ["./phoenix-src/*"] }
  },
  "include": ["phoenix-src", "dashboard", "bootstrap.ts", "vite.config.ts"]
}
