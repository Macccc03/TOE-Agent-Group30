{
  "name": "toe-agent-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Tracing-only frontend reduced from Arize Phoenix original source",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "format:check": "oxfmt --check --config .oxfmtrc.jsonc phoenix-src bootstrap.ts scripts vite.config.ts tsconfig.json package.json index.html",
    "manifest:update": "node scripts/source-manifest.mjs --update",
    "preview": "vite preview --host 127.0.0.1 --port 5175 --strictPort",
    "typecheck": "tsc --noEmit",
    "verify:source": "node scripts/source-manifest.mjs"
  },
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@arizeai/openinference-semantic-conventions": "^2.15.0",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@dnd-kit/abstract": "^0.5.1",
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "@emotion/react": "^11.14.0",
    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "^1.2.5",
    "@pierre/theme": "^1.1.0",
    "@react-aria/utils": "^3.34.1",
    "@streamdown/code": "^1.1.1",
    "@tanstack/react-table": "^9.3.1",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "d3-format": "^3.1.2",
    "d3-scale-chromatic": "^3.1.0",
    "date-fns": "^4.4.0",
    "lodash": "^4.18.1",
    "normalize.css": "^8.0.1",
    "polished": "^4.3.1",
    "react": "19.3.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-hotkeys-hook": "~5.2.4",
    "react-relay": "^21.0.1",
    "react-resizable": "^4.0.2",
    "react-resizable-panels": "^4.14.8",
    "react-router": "^8.5.0",
    "react-stately": "^3.51.0",
    "recharts": "^3.10.1",
    "relay-runtime": "^21.0.1",
    "streamdown": "^2.7.1",
    "tiny-invariant": "^1.3.3",
    "use-zustand": "^0.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/d3-format": "3.0.4",
    "@types/d3-scale-chromatic": "3.1.0",
    "@types/lodash": "4.17.27",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/react-relay": "18.2.1",
    "@types/relay-runtime": "20.1.1",
    "@vitejs/plugin-react": "6.2.1",
    "oxfmt": "0.58.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
